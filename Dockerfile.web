# Stage 1: build the PR08 read-only WebUI/PWA (web/product-hub/) into static assets.
FROM node:20-slim AS web-build

WORKDIR /web

COPY web/product-hub/package.json web/product-hub/package-lock.json ./
RUN npm ci

COPY web/product-hub/ ./
RUN npm run build

# Stage 2: the actual Python service. The built frontend is copied in as plain
# static files - this stage never runs Node, so no npm/JS toolchain ships in
# the deployed image.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    XW_PRODUCT_HUB_WEB_DIST=/app/web/product-hub/dist

WORKDIR /app

COPY requirements-web.txt ./requirements-web.txt
RUN python -m pip install --no-cache-dir -r requirements-web.txt

COPY src ./src
COPY config/content_brands.yaml ./config/content_brands.yaml
COPY --from=web-build /web/dist ./web/product-hub/dist

EXPOSE 8000

CMD ["sh", "-c", "python -m uvicorn xw_office.web.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
